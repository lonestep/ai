# ============================================================================
# 🔒 生产环境配置
# ============================================================================
# 警告：此文件包含敏感信息，不要提交到 Git！
# 确保 .env.production 已添加到 .gitignore

# ============================================================================
# Django 基础配置
# ============================================================================

# 生成新的 SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-very-strong-random-secret-key-here

# 关闭调试模式（生产环境必须）
DEBUG=False

# 允许的主机（用逗号分隔）
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================================================
# 🗄️ 数据库配置（PostgreSQL）
# ============================================================================

DB_NAME=myproject
DB_USER=myproject_user
DB_PASSWORD=strong-database-password-here
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# 🌐 服务器配置
# ============================================================================

# 服务器域名
DOMAIN=bluepivot.net

# 允许的协议（https）
SECURE_SSL_REDIRECT=True

# ============================================================================
# 📧 邮件配置（用于错误通知）
# ============================================================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password-or-app-specific-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ============================================================================
# ☁️ AWS S3 配置（用于文件存储）
# ============================================================================

# 如果使用 S3 存储静态文件和上传文件
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# 📡 Sentry 配置（错误监控）
# ============================================================================

# 如果使用 Sentry 监控错误
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# 🔐 WebSocket 安全
# ============================================================================

# WebSocket 允许的来源
WS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# 🚀 Redis 配置（用于 Channel Layers）
# ============================================================================

# 如果使用 Redis 作为 WebSocket 的消息队列
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# ============================================================================
# 📊 监控和日志
# ============================================================================

# 日志级别
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE_PATH=/var/log/django/django.log

# ============================================================================
# 🔍 安全配置
# ============================================================================

# CSRF 信任的来源
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# 会话过期时间（秒）
SESSION_COOKIE_AGE=1209600

# ============================================================================
# 🎯 CORS 配置
# ============================================================================

# CORS 允许的来源（与 CSRF_TRUSTED_ORIGINS 保持一致）
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# 📝 部署说明
# ============================================================================

# 1. 复制此文件为 .env.production
# cp .env.production.example .env.production

# 2. 修改所有配置项为实际值
# 特别是 SECRET_KEY、数据库密码、AWS 密钥等

# 3. 确保文件权限正确
# chmod 600 .env.production

# 4. 在部署时使用：
# export $(cat .env.production | xargs)
# python manage.py runserver

# 或使用 python-decouple：
# pip install python-decouple
# settings.py: from decouple import config
# SECRET_KEY = config('SECRET_KEY')
