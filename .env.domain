# ============================================================================
# 生产环境域名配置
# ============================================================================
# 域名: bluepivot.net
# 服务器IP: 1.14.208.141
# ============================================================================

# 域名配置
DOMAIN=bluepivot.net
WWW_DOMAIN=www.bluepivot.net
SERVER_IP=1.14.208.141

# Django 设置
DEBUG=False
SECRET_KEY=请使用 python -c "import secrets; print(secrets.token_urlsafe(50))" 生成
ALLOWED_HOSTS=${DOMAIN},${WWW_DOMAIN},${SERVER_IP}

# 数据库配置
DB_NAME=myprojectdb
DB_USER=django_user
DB_PASSWORD=请生成强密码_123!@#
DB_HOST=localhost
DB_PORT=5432

# Redis 配置（用于 WebSocket Channel Layers）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 管理员配置
ADMIN_NAME=管理员
ADMIN_EMAIL=admin@${DOMAIN}

# 邮件配置（用于发送通知）
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=${EMAIL_HOST_USER}

# 安全设置
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Sentry 错误监控（可选）
SENTRY_DSN=

# 其他设置
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai
